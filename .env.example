POCKETGRID_HOST=127.0.0.1
POCKETGRID_PORT=8787
POCKETGRID_DATA=./data
POCKETGRID_JOIN_CODE=pocketgrid-demo
POCKETGRID_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,tauri://localhost,http://tauri.localhost
POCKETGRID_AGENT_MODE=manual
# Akamai workshop chat powers Strands; image generation stays on devices.
# POCKETGRID_AGENT_MODE=akamai
AKAMAI_BASE_URL=https://ws.akamai-workshops.com/v1
AKAMAI_CHAT_MODEL=hackathon-chat
AKAMAI_API_KEY=
# Enable real Strands + Amazon Bedrock planning with your own credentials.
# POCKETGRID_AGENT_MODE=bedrock
# AWS_REGION=us-east-1
# POCKETGRID_BEDROCK_MODEL=us.anthropic.claude-sonnet-4-20250514-v1:0
# AWS_PROFILE=your-profile
