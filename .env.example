# Where workers and clients connect. Local defaults shown; use your hosted grid's
# https:// address and private join code instead. Never commit real values.
POCKETGRID_SERVER=http://127.0.0.1:8787
POCKETGRID_JOIN_CODE=pocketgrid-demo
# Your own pairing token from your PocketGrid session (Copy worker pairing token):
POCKETGRID_SESSION_TOKEN=
