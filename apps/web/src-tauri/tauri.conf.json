{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GiPU",
  "version": "0.1.0",
  "identifier": "dev.pocketgrid.desktop",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:5173", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": { "windows": [{ "title": "GiPU", "create": false, "width": 1200, "height": 860, "minWidth": 640, "minHeight": 600 }], "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; connect-src ipc: http://ipc.localhost http: https:" } },
  "bundle": { "active": true, "targets": ["app"], "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"], "shortDescription": "A personal device computing grid", "category": "DeveloperTool" }
}
