POCKETGRID_DOMAIN=grid.example.com
POCKETGRID_JOIN_CODE=replace-with-a-long-random-private-code
POCKETGRID_AGENT_MODE=manual
# Workshop inference access is separate from Linode cloud-management access.
# POCKETGRID_AGENT_MODE=akamai
AKAMAI_BASE_URL=https://ws.akamai-workshops.com/v1
AKAMAI_CHAT_MODEL=hackathon-chat
AKAMAI_API_KEY=
# Images: cloud (the hosted hackathon-image model, needs AKAMAI_API_KEY) or local (on-device Tiny-SD).
POCKETGRID_IMAGE_GENERATOR=cloud
# Optional real Strands Bedrock planner; image inference stays on devices.
# POCKETGRID_AGENT_MODE=bedrock
# POCKETGRID_BEDROCK_MODEL=your-accessible-bedrock-model-id
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
